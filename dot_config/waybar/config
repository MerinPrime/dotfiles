{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 5,
    "margin-left": 32,
    "margin-right": 32,
    "margin-top": 14,

    "modules-left": [
        "group/left"
    ],
    "modules-center": [
        "group/center"
    ],
    "modules-right": [
        "group/right"
    ],

    "group/left": {
        "orientation": "horizontal",
        "modules": [
            "hyprland/workspaces",
            "temperature"
        ]
    },

    "group/center": {
        "orientation": "horizontal",
        "modules": [
            "custom/spotify"
        ]
    },

    "group/right": {
        "orientation": "horizontal",
        "modules": [
            "clock"
        ]
    },

    "hyprland/workspaces": {
        "all-outputs": true,
        "format": "{name}",
        "on-click": "activate"
    },

    "custom/spotify": {
        "exec": "python3 ~/.config/waybar/mediaplayer.py --player spotify",
        "format": "{}",
        "return-type": "json",
        "on-click": "playerctl play-pause -p spotify"
    },

    "temperature": {
        "thermal-zone": 1,
        "interval": 5,
        "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
        "critical-threshold": 80,
        "format-critical": "{temperatureC}°C ",
        "format": "{temperatureC}°C ",
        "format-icons": ["", "", ""],
        "max-length": 6,
        "min-length": 5,
        "tooltip-format": ""
    },

    "clock": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%A, %d %B %Y}",
        "tooltip-format": "{calendar}"
    }
}
